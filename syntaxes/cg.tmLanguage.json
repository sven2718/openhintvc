{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Cg",
    "scopeName": "source.cg",
    "fileTypes": ["cg"],

    "patterns": [
        { "include": "#comments" },
        { "include": "#preprocessor" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#semantics" },
        { "include": "#operators" },
        { "include": "#intrinsics" },
        { "include": "#function-definition" }
    ],

    "repository": {

        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.cg",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.cg",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },

        "strings": {
            "name": "string.quoted.double.cg",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.cg",
                    "match": "\\\\."
                }
            ]
        },

        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.cg",
                    "match": "\\b0[xX][0-9a-fA-F]+[uU]?\\b"
                },
                {
                    "comment": "Float with exponent, or mandatory decimal point (1.0, .5, 2.5e-3, 1f, 0.5h)",
                    "name": "constant.numeric.float.cg",
                    "match": "\\b([0-9]+\\.?[0-9]*|\\.[0-9]+)([eE][+-]?[0-9]+)?[fFhH]?\\b"
                }
            ]
        },

        "operators": {
            "patterns": [
                {
                    "comment": "Token-paste (##) and stringize (#) operators — inside macro bodies",
                    "name": "keyword.operator.preprocessor.cg",
                    "match": "##|#@"
                },
                {
                    "name": "keyword.operator.assignment.cg",
                    "match": "[+\\-*/%&|^~]?=|<<=|>>="
                },
                {
                    "name": "keyword.operator.comparison.cg",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.cg",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.arithmetic.cg",
                    "match": "\\+\\+|--|[+\\-*/%]"
                },
                {
                    "name": "keyword.operator.bitwise.cg",
                    "match": "<<|>>|[&|^~]"
                },
                {
                    "name": "keyword.operator.ternary.cg",
                    "match": "\\?|:"
                }
            ]
        },

        "constants": {
            "name": "constant.language.cg",
            "match": "\\b(true|TRUE|false|FALSE|NULL)\\b"
        },

        "keywords": {
            "patterns": [
                {
                    "comment": "Control flow",
                    "name": "keyword.control.cg",
                    "match": "\\b(break|case|continue|default|discard|do|else|for|if|return|switch|while)\\b"
                },
                {
                    "comment": "Storage qualifiers and declaration specifiers",
                    "name": "storage.modifier.cg",
                    "match": "\\b(const|extern|in|inline|inout|out|static|uniform|varying|volatile|shared|packed|typedef|noperspective|centroid|attribute)\\b"
                },
                {
                    "comment": "Struct keyword",
                    "name": "storage.type.struct.cg",
                    "match": "\\bstruct\\b"
                }
            ]
        },

        "types": {
            "patterns": [
                {
                    "comment": "Matrix types — must precede vector/scalar to avoid partial matches (e.g. float4x4 before float4 before float)",
                    "name": "storage.type.matrix.cg",
                    "match": "\\b(float[1-4]x[1-4]|half[1-4]x[1-4]|fixed[1-4]x[1-4]|int[1-4]x[1-4]|bool[1-4]x[1-4])\\b"
                },
                {
                    "comment": "Vector types",
                    "name": "storage.type.vector.cg",
                    "match": "\\b(float[1-4]|half[1-4]|fixed[1-4]|int[1-4]|bool[1-4])\\b"
                },
                {
                    "comment": "Scalar types",
                    "name": "storage.type.scalar.cg",
                    "match": "\\b(void|bool|float|half|fixed|char|short|long|int|unsigned)\\b"
                },
                {
                    "comment": "Sampler types",
                    "name": "storage.type.sampler.cg",
                    "match": "\\b(sampler|sampler1D|sampler2D|sampler3D|samplerCUBE|samplerRECT|sampler2DARRAY|sampler1DARRAY|samplerCUBEARRAY|sampler2DMS|sampler2DMSARRAY|samplerBUF|samplerRBUF)\\b"
                }
            ]
        },

        "semantics": {
            "comment": "Cg semantic bindings: : COLOR, : TEXCOORD0, : POSITION, etc.",
            "name": "support.type.semantic.cg",
            "match": ":\\s*(POSITION[0-9]*|COLOR[0-9]*|TEXCOORD[0-9]*|NORMAL|TANGENT|BINORMAL|DEPTH|PSIZE|BLENDINDICES|BLENDWEIGHT|FOGCOORD|WPOS|HPOS|COL[0-9]*|TEX[0-9]*)\\b"
        },

        "function-definition": {
            "comment": "Highlight function-like names followed by '(' — gives rough function-call and function-definition highlighting without false positives from the intrinsic list",
            "patterns": [
                {
                    "name": "entity.name.function.cg",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                }
            ]
        },

        "intrinsics": {
            "comment": "Cg standard library functions — scoped as support.function for distinct coloring from user functions",
            "name": "support.function.intrinsic.cg",
            "match": "\\b(abs|acos|all|any|asin|atan|atan2|bitCount|bitfieldExtract|bitfieldInsert|bitfieldReverse|ceil|clamp|clip|cos|cosh|cross|ddx|ddy|degrees|determinant|distance|dot|exp|exp2|faceforward|findLSB|findMSB|floatToIntBits|floatToRawIntBits|floor|fmod|frac|frexp|fwidth|intBitsToFloat|inverse|isfinite|isinf|isnan|ldexp|length|lerp|lit|log|log10|log2|max|min|modf|mul|normalize|pow|radians|reflect|refract|round|rsqrt|saturate|sign|sin|sincos|sinh|smoothstep|sqrt|step|tan|tanh|tex1D|tex1Dbias|tex1Dcmpbias|tex1Dcmplod|tex1Dfetch|tex1Dlod|tex1Dproj|tex1Dsize|tex1DARRAY|tex1DARRAYbias|tex1DARRAYcmpbias|tex1DARRAYcmplod|tex1DARRAYfetch|tex1DARRAYlod|tex1DARRAYproj|tex1DARRAYsize|tex2D|tex2Dbias|tex2Dcmpbias|tex2Dcmplod|tex2Dfetch|tex2Dlod|tex2Dproj|tex2Dsize|tex2DARRAY|tex2DARRAYbias|tex2DARRAYcmpbias|tex2DARRAYcmplod|tex2DARRAYfetch|tex2DARRAYlod|tex2DARRAYproj|tex2DARRAYsize|tex2DMSfetch|tex2DMSARRAYfetch|tex2DMSARRAYsize|tex3D|tex3Dbias|tex3Dcmpbias|tex3Dcmplod|tex3Dfetch|tex3Dlod|tex3Dproj|tex3Dsize|texBUF|texBUFsize|texCUBE|texCUBEARRAY|texCUBEARRAYbias|texCUBEARRAYlod|texCUBEARRAYsize|texCUBEbias|texCUBElod|texCUBEproj|texCUBEsize|texRBUF|texRBUFsize|texRECT|texRECTbias|texRECTfetch|texRECTlod|texRECTproj|texRECTsize|transpose|trunc)\\b"
        },

        "preprocessor": {
            "comment": "C-style preprocessor directives. Each directive is a begin/end block that correctly handles backslash line-continuation (\\ at end of line). The end pattern only matches newline when the preceding line did NOT end with a backslash.",
            "patterns": [
                {
                    "comment": "#include \"file.cg\" — the include path is highlighted as a string",
                    "begin": "^\\s*(#)\\s*(include)\\b",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.directive.cg" },
                        "2": { "name": "keyword.control.directive.include.cg" }
                    },
                    "end": "(?<!\\\\)\\n",
                    "name": "meta.preprocessor.include.cg",
                    "patterns": [
                        { "include": "#comments" },
                        {
                            "name": "string.quoted.other.include.cg",
                            "begin": "[\"<]",
                            "end": "[\">]"
                        }
                    ]
                },
                {
                    "comment": "#define — the macro name is highlighted as an entity",
                    "begin": "^\\s*(#)\\s*(define)\\b",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.directive.cg" },
                        "2": { "name": "keyword.control.directive.define.cg" }
                    },
                    "end": "(?<!\\\\)\\n",
                    "name": "meta.preprocessor.macro.cg",
                    "patterns": [
                        { "include": "#comments" },
                        {
                            "comment": "Macro name — the identifier immediately after #define, optionally followed by parameter list",
                            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\([^)]*\\))?",
                            "captures": {
                                "1": { "name": "entity.name.function.preprocessor.cg" },
                                "2": { "name": "variable.parameter.preprocessor.cg" }
                            }
                        },
                        { "include": "#numbers" },
                        { "include": "#strings" },
                        { "include": "#operators" },
                        { "include": "#constants" },
                        { "include": "#types" },
                        { "include": "#intrinsics" }
                    ]
                },
                {
                    "comment": "#ifdef / #ifndef / #undef — single-name directives",
                    "begin": "^\\s*(#)\\s*(ifdef|ifndef|undef)\\b",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.directive.cg" },
                        "2": { "name": "keyword.control.directive.conditional.cg" }
                    },
                    "end": "(?<!\\\\)\\n",
                    "name": "meta.preprocessor.conditional.cg",
                    "patterns": [
                        { "include": "#comments" },
                        {
                            "name": "entity.name.function.preprocessor.cg",
                            "match": "[a-zA-Z_][a-zA-Z0-9_]*"
                        }
                    ]
                },
                {
                    "comment": "#if / #elif — expression-based conditionals; highlight defined() and logical operators",
                    "begin": "^\\s*(#)\\s*(if|elif)\\b",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.directive.cg" },
                        "2": { "name": "keyword.control.directive.conditional.cg" }
                    },
                    "end": "(?<!\\\\)\\n",
                    "name": "meta.preprocessor.conditional.cg",
                    "patterns": [
                        { "include": "#comments" },
                        {
                            "name": "keyword.operator.preprocessor.defined.cg",
                            "match": "\\bdefined\\b"
                        },
                        { "include": "#numbers" },
                        { "include": "#operators" },
                        { "include": "#constants" },
                        {
                            "name": "entity.name.function.preprocessor.cg",
                            "match": "[a-zA-Z_][a-zA-Z0-9_]*"
                        }
                    ]
                },
                {
                    "comment": "#else / #endif / #error / #pragma / #line — standalone directives",
                    "match": "^\\s*(#)\\s*(else|endif|error|pragma|line)\\b",
                    "captures": {
                        "1": { "name": "punctuation.definition.directive.cg" },
                        "2": { "name": "keyword.control.directive.cg" }
                    },
                    "name": "meta.preprocessor.cg"
                }
            ]
        }
    }
}
